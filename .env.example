# Anjadhe Connect — deploy-time configuration. On Railway these are service
# variables; locally, copy to .env and `set -a; source .env` (or use your
# shell's equivalent). NEVER commit real values.

# Upstream provider keys — any subset. Routing order is PROVIDER_ORDER.
SERPER_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=

# Cheapest-adequate first.
PROVIDER_ORDER=serper,brave,tavily

# Hard monthly caps per provider (queries) — the cost-control backstop.
# PROVIDER_BUDGETS={"serper":50000,"tavily":1000}

# Admin endpoints (manual tier upgrades) are disabled until this is set.
ADMIN_TOKEN=

# Optional overrides (defaults shown):
# TIER_QUOTAS={"free":300,"plus":3000,"pro":15000}
# TIER_PER_MINUTE={"free":20,"plus":60,"pro":120}
# MINT_PER_IP_PER_DAY=20
# PORT=8080
# DATA_DIR=./data            # Railway: attach a volume; RAILWAY_VOLUME_MOUNT_PATH wins

# Dev only: canned results, no upstream calls.
# SEARCH_MOCK=1
