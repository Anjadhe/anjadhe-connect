# Anjadhe Connect — deploy-time configuration. On Railway these are service
# variables; locally, copy to .env and `set -a; source .env` (or use your
# shell's equivalent). NEVER commit real values.

# Upstream provider keys — any subset. Routing order is PROVIDER_ORDER.
SERPER_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=

# Cheapest-adequate first.
PROVIDER_ORDER=serper,brave,tavily

# Hard monthly caps per provider (queries) — the cost-control backstop.
# PROVIDER_BUDGETS={"serper":50000,"tavily":1000}

# Min ms between call starts per upstream (server-side req/s protection —
# all clients share these keys). Default paces brave at 1100ms; 0 unpaces.
# PROVIDER_PACE_MS={"brave":1100}

# ── Hosted LLM inference (/v1/llm) ───────────────────────────────────────
# One OpenAI-compatible upstream serving open-weight models — pick a
# provider with a zero-data-retention agreement and record which one.
# Unset = /v1/llm answers 503 "not configured".
# LLM_UPSTREAM_URL=https://api.deepinfra.com/v1/openai
LLM_UPSTREAM_KEY=

# Public model name -> upstream model id. Public names are the app-facing
# API; swap the upstream id (better/cheaper weights) without an app release.
# LLM_MODELS={"anjadhe-cloud":"google/gemma-3-27b-it"}

# Service-wide monthly token cap (in+out) — the hard cost ceiling. When
# spent, /v1/llm refuses until the 1st. 0/unset = uncapped (don't run
# production uncapped).
# LLM_BUDGET_TOKENS=500000000

# Optional overrides (defaults shown):
# LLM_TIER_QUOTAS={"free":{"requests":1000,"tokens":2500000},"plus":{"requests":10000,"tokens":25000000},"pro":{"requests":50000,"tokens":100000000}}
# LLM_PER_MINUTE={"free":10,"plus":30,"pro":60}
# LLM_MAX_CONCURRENT={"free":2,"plus":4,"pro":6}
# LLM_MAX_OUTPUT_TOKENS=2048

# Admin endpoints and the /admin dashboard are disabled until this is set.
# Use a DIFFERENT token per deployment — staging's dashboard should not open
# with production's token.
ADMIN_TOKEN=

# Names this deployment on /healthz and as a banner across the top of
# /admin, e.g. production | staging. Unset = no banner. Anything not
# starting with "prod" is styled as a test deployment.
# ENV_LABEL=

# Optional alert push (alerts always show on /admin regardless). Point at a
# Slack/Discord webhook or an ntfy.sh topic URL; KIND picks the payload
# shape: slack (default) | discord | ntfy.
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_KIND=slack
# ALERT_MINTS_PER_DAY=50     # mints/day above this raises an abuse alert
# ALERT_RESEND_HOURS=6       # a persisting alert re-notifies at most this often

# Optional overrides (defaults shown):
# TIER_QUOTAS={"free":300,"plus":3000,"pro":15000}
# TIER_PER_MINUTE={"free":20,"plus":60,"pro":120}
# MINT_PER_IP_PER_DAY=20
# PORT=8080
# DATA_DIR=./data            # Railway: attach a volume; RAILWAY_VOLUME_MOUNT_PATH wins

# Dev only: canned results, no upstream calls.
# SEARCH_MOCK=1
# LLM_MOCK=1
